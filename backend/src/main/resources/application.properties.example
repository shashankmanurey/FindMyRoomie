# Server
server.port=8080

# Datasource (MySQL) - change these to your DB
spring.datasource.url=jdbc:mysql://localhost:3306/findmyroomie
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# JWT
jwt.secret=YOUR_JWT_SECRET
jwt.expirationMillis=900000
jwt.refreshExpirationMillis=604800000

# CORS
app.cors.allowed-origins=http://localhost:5173

# Room photos are stored outside the database and served by the application.
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB